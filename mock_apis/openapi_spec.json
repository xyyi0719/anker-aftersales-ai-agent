  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "action",
          "ticket_id"
        ],
        "title": "ActionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RetrieveRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 3
          },
          "filters": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Filters"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "RetrieveRequest"
      },
      "TicketRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "TicketRequest"
      },
      "Turn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 8000,
            "title": "Query",
            "default": ""
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "state": {
            "additionalProperties": true,
            "type": "object",
            "title": "State"
          },
          "extraction": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extraction"
          },
          "has_image": {
            "type": "boolean",
            "title": "Has Image",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "Turn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WarrantyRequest": {
        "properties": {
