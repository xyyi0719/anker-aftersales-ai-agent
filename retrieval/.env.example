# M3 Embedding API（用于向量化查询和文档）
M3_API_BASE=https://api.MiniMax.com/v1
M3_API_KEY=sk-xxx
M3_EMBED_MODEL=MiniMax-embed-01

# 服务配置
RETRIEVAL_HOST=0.0.0.0
RETRIEVAL_PORT=8001

# 索引存储
INDEX_DIR=./data/index

# 置信度阈值
CONFIDENCE_THRESHOLD=0.5
TOP1_MIN_SCORE=0.4
HYBRID_BM25_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5

# 切片长度
CHUNK_MIN_LEN=100
CHUNK_MAX_LEN=800